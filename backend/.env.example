# ==============================================================================
# SmritiSetu Spring Boot Backend - Render Environment Variables
# ==============================================================================

# 1. Server Port (Render automatically sets this; default is 8080 or Render's PORT)
PORT=8080

# 2. PostgreSQL Database Configuration (from Render PostgreSQL or Supabase/Neon)
# Example: jdbc:postgresql://dpg-xxxx-a.oregon-postgres.render.com/smritisetu_db?sslmode=require
DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE_NAME>?sslmode=require
DB_USERNAME=smritisetu_user
DB_PASSWORD=your_secure_db_password

# 3. JWT Security Configuration (Generate a strong 256-bit / 32+ character key)
JWT_SECRET=c31677353f478474288b839ef42616f728be7a0aa4c66e2c3a5043bf725b8214
# Token expiration in milliseconds (default: 1800000 = 30 minutes, or 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# 4. Google OAuth2 Client ID (Optional: For Google Sign-In backend verification)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# 5. Python Cognitive AI Model Microservice URL
AI_SERVICE_URL=https://smritisetu-ai-model.onrender.com/

# 6. Cloudinary Configuration for Avatar Uploads
# Option A: Full Connection URL (e.g. cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>)
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# Option B: Individual Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
